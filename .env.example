# ============================================================
# Scientific Paper Comparison Engine — environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── AWS Bedrock ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Bedrock Model IDs ─────────────────────────────────────────
BEDROCK_LLM_MODEL=global.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL=amazon.titan-embed-image-v1

# ── Pinecone ──────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=paper-comparison-engine
PINECONE_ENVIRONMENT=us-east-1

# ── RAG tuning ────────────────────────────────────────────────
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=6
MAX_PAPERS=8
MIN_PAPERS=3
